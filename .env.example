# Cross Creek range configuration.
# Copy to .env (setup.sh does this for you) and edit if you need to.
# Every "1" below enables a deliberate weakness so the attack half works.
# Set it to "0" to take that weakness off the table, or run ./start.sh
# --segmented to apply the whole defended topology at once.

# --- exposure and access (Session 2) ---
# EXPOSE_HMI_TO_EDGE=1 puts the water HMI and the water PLC on the hostile
# edge network alongside the attacker box (the Aliquippa scenario).
EXPOSE_HMI_TO_EDGE=1
# DEFAULT_CREDS=1 leaves the HMI admin login at admin/admin and the PLCs at
# their factory passwords.
DEFAULT_CREDS=1
# EXPOSE_REMOTE_ACCESS=1 runs an unauthenticated VNC-style remote desktop on
# the engineering workstation, reachable from the enterprise net (Oldsmar).
EXPOSE_REMOTE_ACCESS=1
# DNS_AXFR_OPEN=1 leaves the utility name server answering for the whole
# estate and lets any host pull the zone (dig axfr). Scenario 11: one
# transfer from the edge maps every controller. 0 = split-horizon, AXFR
# refused.
DNS_AXFR_OPEN=1

# --- field-protocol ports (Session 2 recon) ---
# None of the three field protocols listens on its IANA-assigned default
# (Modbus 502, S7comm 102, EtherNet/IP 44818). A real assessor cannot assume
# the default either, so `recon.py nmap` does a real full-range port scan
# and NSE-based service ID instead of a hardcoded port list. Change these if
# you want a fresh cohort to have to re-discover different numbers.
PLC_WATER_PORT=10502
PLC_DOSING_PORT=54818
PLC_POWER_PORT=10102

# --- protocol abuse (Session 3) ---
# MODBUS_WRITE_OPEN=1 accepts coil/register writes from any source address.
MODBUS_WRITE_OPEN=1

# --- vendor dialects (Session 4) ---
# S7_NO_PASSWORD=1 lets the substation RTU accept stop-CPU and mode changes
# with no authentication.
S7_NO_PASSWORD=1
# ENIP_ALLOW_LOGIC_DOWNLOAD=1 leaves the dosing controller in REMOTE/PROG and
# runs the unauthenticated logic-update service (documented stand-in for a
# real Studio 5000 download).
ENIP_ALLOW_LOGIC_DOWNLOAD=1

# --- network boundary (Session 5) ---
# FLAT_NETWORK=1 makes the router forward freely between enterprise, DMZ and
# OT. Set to 0 (or use --segmented) to enforce zones and conduits.
FLAT_NETWORK=1

# --- monitoring and recovery (Session 6) ---
# IDS_ENABLED=0 keeps Suricata/Zeek off until the monitoring module.
IDS_ENABLED=0
# HISTORIAN_READONLY=0 leaves the historian link bidirectional (no one-way
# enforcement, so it is a pivot back into OT).
HISTORIAN_READONLY=0

# --- HMI behaviour ---
# VERBOSE_HMI_ERRORS=1 leaks stack traces and raw tag names in HMI responses.
VERBOSE_HMI_ERRORS=1

# --- lab credentials (change nothing here unless an exercise says to) ---
HMI_ADMIN_USER=admin
HMI_ADMIN_PASS=admin
PLC_WATER_PASS=1100
PLC_DOSING_PASS=1100
PLC_POWER_PASS=1100
